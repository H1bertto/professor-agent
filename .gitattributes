# Normalize line endings. The repo is edited from both Windows and WSL.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.vrm binary
*.glb binary
*.wav binary
*.mp3 binary
*.ogg binary
*.onnx binary
*.bin binary
